{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@pjdrive/sync/*": [
        "../sync/src/*"
      ]
    },
    "sourceMap": true
  },
  "include": [
    "src"
  ]
}